# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-here-min-32-characters
JWT_EXPIRATION=86400

# Database (if using different credentials)
# DB_PASSWORD=your-db-password

# Redis (if using different credentials)
# REDIS_PASSWORD=your-redis-password

# Email (if using different credentials)
# MAIL_PASSWORD=your-mail-password

# MinIO (if using different credentials)
# MINIO_ACCESS_KEY=your-minio-access-key
# MINIO_SECRET_KEY=your-minio-secret-key
